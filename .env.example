# Neon Postgres — server-side only, never expose to the browser
DATABASE_URL="postgres://<user>:<password>@<neon-host>/<db>?sslmode=require"

# FortyGuard Temperature API — server-side only, never expose to the browser
FORTYGUARD_API_KEY="your-hackathon-api-key-here"
FORTYGUARD_API_BASE="https://api.fortyguard.com/v1"

# Default adapter mode on page load: "replay" or "live"
# Keep as "replay" for reliable local dev and demo rehearsal; the live toggle
# in the UI can still switch to "live" on demand.
DEFAULT_READING_MODE="replay"
